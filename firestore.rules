rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Profiles opened from a song artist need to be readable by signed-in users.
      // Writes remain restricted to the profile owner below.
      allow read: if signedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'accountSubtitle',
          'audioQuality',
          'streamOnlyOnWifi',
          'darkModeEnabled',
          'cacheSubtitle',
          'appVersion',
          'uploadedSongIds',
          'favoriteSongIds',
          'avatarUrl'
        ]);
      allow delete: if isOwner(userId);
    }

    match /songs/{songId} {
      // Song metadata is public so Discover can load before auth refresh completes.
      // Writes and counters remain protected by the rules below.
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'artist'
        ]);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'viewCount'
        ])
        && !resource.data.keys().hasAny(['viewCount'])
        && request.resource.data.get('viewCount', 0) == 0;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'viewCount'
        ])
        && request.resource.data.get('viewCount', 0)
          == resource.data.get('viewCount', 0) + 1
        && !exists(
          /databases/$(database)/documents/songs/$(songId)/viewers/$(request.auth.uid)
        )
        && getAfter(
          /databases/$(database)/documents/songs/$(songId)/viewers/$(request.auth.uid)
        ).data.userId == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'favoriteCount'
        ])
        && !resource.data.keys().hasAny(['favoriteCount'])
        && request.resource.data.get('favoriteCount', 0) == 0;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'favoriteCount'
        ])
        && request.resource.data.get('favoriteCount', 0) >= 0
        && (
          request.resource.data.get('favoriteCount', 0)
            == resource.data.get('favoriteCount', 0) + 1
          || request.resource.data.get('favoriteCount', 0)
            == resource.data.get('favoriteCount', 0) - 1
        );
      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;

      match /viewers/{userId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasOnly(['userId', 'viewedAt']);
        allow update, delete: if false;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.songId == songId
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.keys().hasOnly([
            'songId',
            'userId',
            'userName',
            'userAvatarUrl',
            'content',
            'timestampMs',
            'createdAt'
          ]);
        allow update: if signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'content'
          ]);
        allow delete: if signedIn()
          && resource.data.userId == request.auth.uid;
      }
    }
  }
}
