<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/now_playing_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/black">
    <ImageView android:id="@+id/now_playing_cover" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.52" android:scaleType="centerCrop" android:src="@drawable/ic_launcher_background" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="28dp" android:paddingTop="32dp" android:paddingEnd="28dp" android:paddingBottom="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageButton android:id="@+id/now_playing_back" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:contentDescription="Quay lại" android:src="@drawable/back" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Now Playing" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold" />
            <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:contentDescription="Thêm" android:src="@drawable/more" />
        </LinearLayout>
        <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/now_playing_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:ellipsize="marquee" android:textColor="@color/white" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:id="@+id/now_playing_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textColor="@color/muted_text" android:textSize="18sp" />
        <SeekBar android:id="@+id/now_playing_seek" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:progressTint="@color/white" android:thumbTint="@color/accent_yellow" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="28dp">
            <ImageButton android:id="@+id/now_playing_previous" android:layout_width="64dp" android:layout_height="64dp" android:background="@android:color/transparent" android:contentDescription="Bài trước" android:src="@drawable/rewind" />
            <ImageButton android:id="@+id/now_playing_play_pause" android:layout_width="80dp" android:layout_height="80dp" android:background="@android:color/transparent" android:contentDescription="Phát hoặc tạm dừng" android:src="@drawable/resume" />
            <ImageButton android:id="@+id/now_playing_next" android:layout_width="64dp" android:layout_height="64dp" android:background="@android:color/transparent" android:contentDescription="Bài tiếp theo" android:src="@drawable/fastforwad" />
        </LinearLayout>
        <TextView android:id="@+id/now_playing_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:textColor="@color/muted_text" />
    </LinearLayout>
    <ProgressBar android:id="@+id/now_playing_loading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" />
    <TextView android:id="@+id/now_playing_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:padding="24dp" android:textColor="@color/white" android:visibility="gone" />
</FrameLayout>
