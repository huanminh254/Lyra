<?xml version="1.0" encoding="utf-8"?>
<com.devpro.sound.ui.components.SwipeDismissFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/now_playing_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101010"
    >

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/now_playing_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="80dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="46dp"
        app:cardElevation="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <ImageView
            android:id="@+id/now_playing_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.58"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#65000000"
            android:importantForAccessibility="no" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/now_playing_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="28dp"
            android:paddingTop="10dp"
            android:paddingEnd="28dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/now_playing_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="#E6000000"
                android:ellipsize="end"
                android:maxLines="2"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/now_playing_back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/now_playing_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#E6000000"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingTop="4dp"
                android:paddingEnd="14dp"
                android:paddingBottom="4dp"
                android:textColor="#FFE0E0E0"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/now_playing_title" />

            <TextView
                android:id="@+id/now_playing_behind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#E6000000"
                android:paddingStart="14dp"
                android:paddingTop="5dp"
                android:paddingEnd="14dp"
                android:paddingBottom="5dp"
                android:text="▥  Behind this track"
                android:textColor="#FFE0E0E0"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/now_playing_artist" />

            <ImageButton
                android:id="@+id/now_playing_back"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/play_circle_background"
                android:contentDescription="Đóng màn hình đang phát"
                android:padding="12dp"
                android:src="@drawable/ic_chevron_down"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/now_playing_more"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/play_circle_background"
                android:contentDescription="Thêm người theo dõi"
                android:padding="12dp"
                android:src="@drawable/ic_person_add"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/now_playing_back" />

            <LinearLayout
                android:id="@+id/now_playing_controls"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintBottom_toTopOf="@id/now_playing_comment_overlay"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/now_playing_behind">

                <ImageButton
                    android:id="@+id/now_playing_previous"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="0dp"
                    android:contentDescription="@string/previous_song"
                    android:padding="22dp"
                    android:src="@drawable/rewind"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    app:tint="@color/white" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/now_playing_play_pause"
                    android:layout_width="88dp"
                    android:layout_height="112dp"
                    android:contentDescription="@string/play_pause"
                    android:padding="28dp"
                    android:src="@drawable/resume"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    app:tint="@color/white" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/now_playing_next"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@string/next_song"
                    android:padding="22dp"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:src="@drawable/fastforwad"
                    app:tint="@color/white" />
            </LinearLayout>

            <TextView
                android:id="@+id/now_playing_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@id/now_playing_seek"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

                <com.devpro.sound.ui.components.WaveformView
                    android:id="@+id/now_playing_seek"
                    android:layout_width="0dp"
                    android:layout_height="132dp"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintBottom_toTopOf="@id/now_playing_comment_bar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            <FrameLayout
                android:id="@+id/now_playing_comment_overlay"
                android:layout_width="0dp"
                android:layout_height="136dp"
                android:clipChildren="false"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@id/now_playing_time"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout
                android:id="@+id/now_playing_comment_bar"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:background="@drawable/comment_bar_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:id="@+id/comment_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/comment_avatar_background"
                    android:clipToOutline="true"
                    android:contentDescription="@string/comment_avatar_description"
                    android:scaleType="centerCrop"
                    android:src="@drawable/account" />

                <EditText
                    android:id="@+id/comment_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/comment_hint"
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textColorHint="@color/muted_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/comment_send"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:contentDescription="Gửi bình luận"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Gửi"
                    android:textColor="#FFFFB000"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/comment_fire"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:contentDescription="@string/comment_fire"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🔥"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/comment_wave"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:contentDescription="@string/comment_wave"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="👋"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/comment_cry"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:contentDescription="@string/comment_cry"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🥺"
                    android:textSize="24sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>


    <LinearLayout
        android:id="@+id/now_playing_actions"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:background="#FF101010"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/now_playing_like"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Yêu thích"
                android:padding="4dp"
                android:src="@drawable/ic_favorite" />

            <TextView
                android:id="@+id/now_playing_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="15.6K"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/now_playing_comment_action"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Bình luận"
                android:padding="4dp"
                android:src="@drawable/ic_comment" />

            <TextView
                android:id="@+id/now_playing_comment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="55"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/now_playing_share"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Chia sẻ"
            android:padding="10dp"
            android:src="@drawable/ic_share" />

        <ImageButton
            android:id="@+id/now_playing_playlist"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Thêm vào danh sách phát"
            android:padding="10dp"
            android:src="@drawable/ic_playlist_play" />

        <ImageButton
            android:id="@+id/now_playing_more_bottom"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Thêm tùy chọn"
            android:padding="10dp"
            android:src="@drawable/more"
            app:tint="@color/white" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/now_playing_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/now_playing_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="@color/white"
        android:visibility="gone" />
</com.devpro.sound.ui.components.SwipeDismissFrameLayout>
