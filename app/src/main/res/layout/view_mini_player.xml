<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mini_player"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@color/panel_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="12dp">
    <ImageView
        android:id="@+id/mini_cover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="Ảnh bìa"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher_background" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/mini_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/white" android:textStyle="bold" />
        <TextView android:id="@+id/mini_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/muted_text" android:textSize="12sp" />
    </LinearLayout>
    <ImageButton
        android:id="@+id/mini_play_pause"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="Phát hoặc tạm dừng"
        android:padding="12dp"
        android:src="@drawable/resume" />
</LinearLayout>
